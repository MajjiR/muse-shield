{
  "manifest_version": 3,
  "name": "Muse Shield for Meta AI",
  "version": "0.2.0",
  "description": "Type in Muse Shield's box on meta.ai: sensitive details are masked on your device before Meta AI sees them, and restored only for you.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.meta.ai/*", "https://meta.ai/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Turn Muse Shield on or off" },
  "content_scripts": [
    {
      "matches": ["https://www.meta.ai/*", "https://meta.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["composer.html", "reply.html"],
      "matches": ["https://www.meta.ai/*", "https://meta.ai/*"]
    }
  ]
}
