# Muse Spark on the Meta Model API (sees masked text only).
CLOUD_BASE_URL=https://api.meta.ai/v1
CLOUD_MODEL=muse-spark-1.3
MODEL_API_KEY=

# Muse Glimmer 30B for analysis (sees raw text: synthetic data only on third-party hosts).
# Fireworks serverless by default; set GLIMMER_BASE_URL to a vLLM/SGLang server to self-host.
ENGINE_BACKEND=glimmer
FIREWORKS_API_KEY=
# GLIMMER_BASE_URL=https://api.fireworks.ai/inference/v1
# GLIMMER_MODEL=accounts/fireworks/models/muse-glimmer-30b

# Development only: let Muse Spark run analysis on synthetic data.
# MUSE_SPARK_SYNTHETIC_ONLY=1
