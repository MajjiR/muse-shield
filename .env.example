# Muse Spark on the Meta Model API (sees masked text only).
CLOUD_BASE_URL=https://api.meta.ai/v1
CLOUD_MODEL=muse-spark-1.3
MODEL_API_KEY=

# Muse Glimmer 30B for analysis (sees raw text: synthetic data only on third-party hosts).
# Fireworks serverless by default; set GLIMMER_BASE_URL to a vLLM/SGLang server to self-host.
ENGINE_BACKEND=glimmer
FIREWORKS_API_KEY=
# Glimmer isn't serverless on Fireworks: point at your on-demand deployment.
GLIMMER_DEPLOYMENT=accounts/<your-account>/deployments/<id>
# GLIMMER_BASE_URL=https://api.fireworks.ai/inference/v1
# GLIMMER_MODEL=accounts/fireworks/models/muse-glimmer-30b

# Meta Model API analysis sees raw text: allow it only for synthetic or public benchmark data.
# META_SYNTHETIC_ONLY=1
# MUSE_WONDER_MODEL=muse-wonder-1.0
# Spark and Wonder reason before answering: minimal | low | medium | high
# META_REASONING_EFFORT=low
# Token budget including hidden reasoning (raise for medium/high effort)
# META_MAX_TOKENS=4096
