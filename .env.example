# Local detector: any OpenAI-compatible endpoint. Ollama serves one at /v1.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:1b

# Cloud LLM (only ever receives masked text). Llama API is OpenAI-compatible.
# Leave CLOUD_API_KEY empty to use the offline mock cloud for demos.
CLOUD_BASE_URL=https://api.llama.com/compat/v1
CLOUD_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
CLOUD_API_KEY=

# Vault key: if set, derived with scrypt; otherwise a random key file is created in .privacy/
PRIVACY_ENGINE_PASSPHRASE=
PRIVACY_ENGINE_HOME=.privacy
