# Local detector: any OpenAI-compatible endpoint. Ollama serves one at /v1.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:1b

# Cloud LLM (only ever receives masked text): Muse Spark on the Meta Model API.
# Other ids: muse-spark-1.3-contributor (discounted), muse-wonder-1.0 (most capable).
# Leave the key empty to use the offline mock cloud for demos.
CLOUD_BASE_URL=https://api.meta.ai/v1
CLOUD_MODEL=muse-spark-1.3
MODEL_API_KEY=

# Vault key: if set, derived with scrypt; otherwise a random key file is created in .privacy/
PRIVACY_ENGINE_PASSPHRASE=
PRIVACY_ENGINE_HOME=.privacy
